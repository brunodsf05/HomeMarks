{
  "name": "homemarks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension.chrome": "cross-env-shell RUNTIME=\"extension.chrome\" \"tsc -b && vite build\"",
    "build:extension.firefox": "cross-env-shell RUNTIME=\"extension.firefox\" \"tsc -b && vite build\"",
    "format": "prettier \"src/**/*.{ts,tsx,js,jsx,css,html,json,md,yml,yaml}\" --write",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^25.8.10",
    "modern-normalize": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.54.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.1",
    "webextension-polyfill": "^0.12.0"
  }
}
